{
  "name": "ipe-crm",
  "productName": "Ipê CRM",
  "version": "0.1.0",
  "description": "CRM de desktop que se atualiza sozinho com os contatos de um bot de WhatsApp.",
  "type": "module",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/sync.test.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.bytenuvem.ipecrm",
    "productName": "Ipê CRM",
    "artifactName": "Ipe-CRM-Instalador-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Ipê CRM" }
  }
}
